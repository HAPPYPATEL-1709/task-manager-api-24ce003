# Task Manager API Environment Configuration

# --- Option 1: Docker Compose (Practical 11) ---
# References the MongoDB service container by service name on the Docker network
MONGO_URI=mongodb://mongodb:27017/taskdb

# --- Option 2: Localhost MongoDB ---
# MONGO_URI=mongodb://127.0.0.1:27017/taskdb

# --- Option 3: MongoDB Atlas Cluster ---
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/task_manager?retryWrites=true&w=majority

PORT=5000
JWT_SECRET=super_secret_jwt_practical_11_key
JWT_EXPIRES_IN=1h